{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/modbus-scada-api", "sidecar": true }
      ]
    }
  ]
}
